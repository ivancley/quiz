# Ambiente da bateria ponta a ponta (skill testar-ucs).
#
# Existe separado de .env.test porque as duas suítes rodam contra bancos
# diferentes: o Vitest usa quiz_teste e trunca as tabelas entre casos, enquanto
# a bateria E2E recria quiz_e2e do zero e sobe uma aplicação real em cima dele.
# Compartilhar um banco faria uma suíte apagar o estado da outra no meio.

# Porta padrão do Next.js + 31 seria 3031, que é onde roda o `npm run dev` do
# dia a dia. A bateria usa a seguinte para poder subir sem derrubar o servidor
# de desenvolvimento que já estiver aberto.
APP_PORT=3032

DATABASE_URL=postgres://quiz:quiz@localhost:5463/quiz_e2e
APP_BASE_URL=http://localhost:3032

# Administrador único (RF-040). Senha em texto puro: teste1234 — é credencial de
# teste, fixa e pública de propósito, para os specs poderem citá-la.
ADMIN_EMAIL=admin@teste.local
ADMIN_PASSWORD_HASH=$2b$10$ZojO6R2ZX72C6ESB.jyuaej94638oujO/kaZ/CoZsCrk72EN2XKaG

AUTH_SECRET=MBDVGGm0xXjEqOqfYkike/g12b9Gb5UWR42OHE5MAVVTSZI9oVrLYRWgZidcVCey
