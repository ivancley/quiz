{
  "name": "quiz-ao-vivo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:hash": "node scripts/gerar-hash-de-senha.ts",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:reset:e2e": "node scripts/resetar-banco-e2e.ts",
    "e2e:servidor": "next build && next start -p ${APP_PORT:-3032}",
    "dev": "next dev -p ${APP_PORT:-3031}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "next start -p ${APP_PORT:-3031}",
    "test": "vitest run",
    "test:e2e": "npm run db:reset:e2e && playwright test",
    "test:e2e:ui": "npm run db:reset:e2e && playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
