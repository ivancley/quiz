# --- Portas locais ---------------------------------------------------------
# Esta máquina roda vários projetos em Docker ao mesmo tempo. Por convenção do
# projeto, toda porta local é a porta padrão do serviço somada a 31, para não
# colidir: Next.js 3000 -> 3031, Postgres 5432 -> 5463.
APP_PORT=3031
DB_PORT=5463

# --- Banco de dados --------------------------------------------------------
DATABASE_URL=postgres://quiz:quiz@localhost:5463/quiz

# --- Endereço público ------------------------------------------------------
# Onde a aplicação está hospedada, sem barra no final.
# É o que vai embutido no QR Code projetado na parede — se estiver errado,
# o código impresso aponta para um endereço inacessível e ninguém entra.
# Em produção: https://quiz.seudominio.com.br
APP_BASE_URL=http://localhost:3031

# --- Administrador único ---------------------------------------------------
# Gere a linha com: npm run admin:hash -- 'sua-senha' e cole-a inteira.
# Os cifrões saem escapados de propósito, e a linha vai colada como veio: um
# hash bcrypt é feito de cifrões, e leitor de .env costuma tratar $ como início
# de variável. Colado cru, o hash chega mutilado ao servidor e todo login é
# recusado, sem nenhum erro que aponte para a causa.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD_HASH=''

# --- Assinatura de cookies -------------------------------------------------
# Usada para os cookies de administrador e de participante.
# Gere com: openssl rand -base64 48
AUTH_SECRET=
